# Local MCP configuration
.mcp.json
mcp-servers/

# Reference documentation (not part of website) — anchored to repo root
# so it does not match content/posts/resources/ (Zola section).
/resources/

# Zola build output
public/
static/giallo-*.css

# Related-posts index — build artifact, regenerated by scripts/compute-related.py
# in build.sh before each `zola build` (same lifecycle as the Pagefind index).
related.json

# Download file sizes — same lifecycle, measured by build.sh from the files being
# deployed. Kept out of static/ because only templates read it; nothing fetches it.
download-sizes.json

# Demo → parent-post index — same lifecycle, derived by scripts/build-demo-index.py
# from the demo() shortcode calls in content/posts/. Committing it would let it
# disagree with the posts, which is the whole failure the derivation avoids.
static/demos/_shared/demos.json

# mdBook build output
docs/book/

# Build outputs (future)
target/
dist/

# Python bytecode caches
__pycache__/
*.pyc

# aipack (personal workflow tooling)
.aipack/

# Playwright MCP output (snapshots/screenshots from UI verification sweeps)
.playwright-mcp/

# Post-system capture drafts (per POST_SYSTEM_PLAN — stay in working tree, never tracked)
logbook/_drafts/
cookbook/_drafts/

# Per-form feedback queues — working-tree-only scratch; promote into the
# editorial doc when ready (see editorial/_feedback/<form>.md Meta section).
editorial/_feedback/

# Session conversation logs
.log/

# Curiosity captures (concepts-post trigger pipeline) — gitignored, parent-synced
.curiosities/

# In-progress post drafts held back from a PUBLIC repo.
#
# `draft = true` keeps a post off the built site, but it does NOT keep the
# markdown out of git — the source stays readable on GitHub. public-gate.sh will
# not catch this either: its patterns deliberately exclude markdown posts to keep
# false positives near zero. So holding a draft back is a manual act, and this is
# where it goes. Delete the line when the post is ready to be public.
content/posts/opinions/skip-the-boilerplate.md

# OS files
.DS_Store
Thumbs.db

# Archived files
.archive/
